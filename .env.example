# Copy to .env and fill in. .env is git-ignored; secrets are pushed to Secret Manager by infra/03_secrets.sh.
# Keep values simple (no spaces) or wrap them in double quotes: this file is read by both bash and Python.

# --- Google Cloud (from the Builderbase team link) ---
GCP_PROJECT_ID=
GCP_REGION=europe-west1
BQ_DATASET=kate
BQ_LOCATION=europe-west1

# Gemini on Vertex AI. Gemini 3.x only runs on multi-region endpoints: "eu" keeps processing in the EU.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=eu
GEMINI_THINKING_LEVEL=low

# --- ElevenLabs (coupon from the ElevenLabs Discord, key from elevenlabs.io > Developers > API keys) ---
ELEVENLABS_API_KEY=
# Any voice from your ElevenLabs library; list them with: make voices
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_AGENT_LLM=gemini-3.5-flash
ELEVENLABS_AGENT_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Code your team and the judges type into the demo login. Leave empty to generate one.
DEMO_ACCESS_CODE=

# Comma-separated origins of a separately hosted frontend, e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Deploy knobs: set MIN_INSTANCES=1 before recording the demo video (no cold starts).
MIN_INSTANCES=0
# cloudbuild (default) or docker (build locally, push to Artifact Registry)
BUILD_MODE=cloudbuild
