# Pick ONE provider. With no key at all the app still works in "template mode"
# (engine does the math, canned sentences do the explaining). Demo never breaks.

# Google (sponsor credits) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint
# ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=gemini        # gemini | openai | anthropic (auto-detected from keys otherwise)
# LLM_MODEL=gemini-2.5-flash # whatever model name your key has access to
# LLM_TIMEOUT_MS=12000

# Optional: nicer voice for read-aloud (falls back to the browser's built-in voice)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
